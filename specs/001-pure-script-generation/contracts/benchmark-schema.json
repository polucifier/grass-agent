{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GrassAgentBenchmarkSuite",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["single_tool", "multi_step", "edge_case"]
          },
          "prompt": { "type": "string" },
          "expected_tools": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["id", "category", "prompt", "expected_tools"]
      }
    }
  },
  "required": ["version", "test_cases"]
}
