<?xml version="1.0" encoding="utf-8"?>
<task name="v.clean">
	<description>
		Toolset for cleaning topology of vector map.
	</description>
	<parameter name="input" type="string" required="yes" multiple="no">
		<description>Name of input vector map</description>
	</parameter>
	<parameter name="output" type="string" required="yes" multiple="no">
		<description>Name for output vector map</description>
	</parameter>
	<parameter name="layer" type="string" required="no" multiple="no">
		<description>Layer number or name</description>
		<default>-1</default>
	</parameter>
	<parameter name="type" type="string" required="no" multiple="yes">
		<description>Input feature type</description>
		<default>point,line,boundary,centroid,area,face,kernel</default>
		<values>
			<value><name>point</name><description>point feature</description></value>
			<value><name>line</name><description>line feature</description></value>
			<value><name>boundary</name><description>boundary feature</description></value>
			<value><name>centroid</name><description>centroid feature</description></value>
			<value><name>area</name><description>area feature</description></value>
			<value><name>face</name><description>face feature</description></value>
			<value><name>kernel</name><description>kernel feature</description></value>
		</values>
	</parameter>
	<parameter name="tool" type="string" required="yes" multiple="yes">
		<description>Cleaning tool</description>
		<values>
			<value><name>break</name><description>break lines at each intersection</description></value>
			<value><name>snap</name><description>snap lines to vertex in threshold</description></value>
			<value><name>rmdupl</name><description>remove duplicate geometry features</description></value>
			<value><name>rmdangle</name><description>remove dangles</description></value>
		</values>
	</parameter>
	<parameter name="threshold" type="double" required="no" multiple="yes">
		<description>One value for each tool</description>
		<default>0.0</default>
	</parameter>
	<flag name="b">
		<description>Do not build topology for the output vector</description>
	</flag>
	<flag name="c">
		<description>Combine tools with recommended follow-up tools</description>
	</flag>
</task>
